# EducaFlex — variáveis Docker Compose (copie para .env na raiz)
#
#   cp .env.example .env
#
# Desenvolvimento local (recomendado):
#   docker compose up -d mysql
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env.local
#
# Stack Docker completa:
#   docker compose --profile full up -d --build

# ── MySQL (serviço mysql) ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=educaflex
MYSQL_USER=educaflex
MYSQL_PASSWORD=educaflex
MYSQL_PORT=3306

# ── API (serviço api — profile full) ───────────────────────────
API_PORT=3001
JWT_SECRET=dev-secret-change-in-production-use-long-random-string
JWT_ACCESS_EXPIRES=8h
INTEGRATIONS_MODE=mock
NODE_ENV=development
CORS_ORIGINS=http://localhost:3002,http://localhost:3000,http://localhost:8080
UPLOAD_MAX_BYTES=10485760
EMAIL_FROM=noreply@educaflex.test
RESET_PASSWORD_BASE_URL=http://localhost:3002/recuperar-senha

# ── Web (serviço web — profile full) ───────────────────────────
WEB_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_USE_MOCK_API=false

# ── Smoke tests (tests/smoke — opcional) ─────────────────────────
# EDUCAFLEX_API_URL=http://localhost:3001/api/v1
# EDUCAFLEX_SMOKE=1
